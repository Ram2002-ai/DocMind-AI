# DocuMind AI Backend Environment Configuration

# Application
APP_NAME="DocuMind AI"
APP_VERSION="1.0.0"
DEBUG=false

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://docmind-ai-1-hd4f.onrender.com"]

# Database
# Local PostgreSQL uses localhost only when PostgreSQL is running on this machine.
# On Render, set DATABASE_URL to the database's Internal Database URL, or set
# DATABASE_PRIVATE_URL to that value. Never use localhost for a separate Render
# PostgreSQL service.
DATABASE_URL=
DATABASE_PRIVATE_URL=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Groq LLM
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Document Processing
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3
RETRIEVAL_THRESHOLD=0.5

# File Upload
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=data/uploads
EXTRACT_DIR=data/extracted

# Optional: Poppler path for PDF to image conversion (Windows)
POPPLER_PATH=

# LangGraph / tools
LANGGRAPH_CHECKPOINT_PATH=data/langgraph_checkpoints.db
ALPHA_VANTAGE_API_KEY=

# Logging
LOG_LEVEL=INFO
