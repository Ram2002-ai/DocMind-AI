# DocuMind AI Backend Environment Configuration

# Application
APP_NAME="DocuMind AI"
APP_VERSION="1.0.0"
DEBUG=false

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database
DATABASE_URL=postgresql://documind:documind_password@localhost:5432/documind_db

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001

# OpenRouter LLM
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=DocuMind AI
OPENROUTER_PROVIDER_SORT=throughput
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Document Processing
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3
RETRIEVAL_THRESHOLD=0.5

# File Upload
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=data/uploads
EXTRACT_DIR=data/extracted

# Optional: Poppler path for PDF to image conversion (Windows)
POPPLER_PATH=

# Logging
LOG_LEVEL=INFO
